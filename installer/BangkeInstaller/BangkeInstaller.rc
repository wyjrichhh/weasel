// BangkeInstaller resource
#define VER_STRINGIZE(x) #x
#define VER_STR(x) VER_STRINGIZE(x)

1 ICON "..\\..\\resource\\bangke.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_BUILD
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bangke Pinyin"
            VALUE "FileDescription", "Bangke Pinyin Installer"
            VALUE "FileVersion", VER_STR(VERSION_MAJOR.VERSION_MINOR.VERSION_PATCH.VERSION_BUILD)
            VALUE "InternalName", "BangkeInstaller"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "BangkeInstaller.exe"
            VALUE "ProductName", "Bangke Pinyin"
            VALUE "ProductVersion", VER_STR(VERSION_MAJOR.VERSION_MINOR.VERSION_PATCH)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
